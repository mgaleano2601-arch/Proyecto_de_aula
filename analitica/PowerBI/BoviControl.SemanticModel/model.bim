        "lineageTag": "bed62942-1cf4-4da0-9fa6-1034e73097e7",
        "measures": [
          {
            "name": "Animales registrados",
            "expression": "COUNTROWS(DimAnimal)",
            "formatString": "#,0",
            "lineageTag": "6ee59596-2b87-4519-8839-24d113a51c8d"
          },
          {
            "name": "Vacunas aplicadas",
            "expression": "SUM(FactVacunacion[Dosis])",
            "formatString": "#,0",
            "lineageTag": "65a0c9b8-fbc9-4433-8ab6-dca6aa2b1c59"
          },
          {
            "name": "Animales con aplicaciones",
            "expression": "DISTINCTCOUNT(FactVacunacion[AnimalKey])",
            "formatString": "#,0",
            "lineageTag": "44d15d4e-3279-4497-bbd0-ae248b7c994f"
          },
          {
            "name": "Dosis vencidas al corte",
            "expression": "CALCULATE([Vacunas aplicadas], REMOVEFILTERS(DimFecha), DimEstado[EstadoKey] = 1, FactVacunacion[EsUltimoRegistro] = 1)",
            "formatString": "#,0",
            "lineageTag": "bc8dcde1-32e8-4471-bd0a-c87eda20e7ae"
          },
          {
            "name": "Dosis proximas 7 dias",
            "expression": "CALCULATE([Vacunas aplicadas], REMOVEFILTERS(DimFecha), DimEstado[EstadoKey] = 2, FactVacunacion[EsUltimoRegistro] = 1)",
            "formatString": "#,0",
            "lineageTag": "e89912dd-a341-4279-9cef-eaaa51ed1bef"
          },
          {
            "name": "Litros registrados",
            "expression": "SUM(FactLeche[Litros])",
            "formatString": "#,0.00",
            "lineageTag": "cfad53db-f194-4dab-842f-bd1788cf9416"
          },
          {
            "name": "Registros de leche",
            "expression": "COUNTROWS(FactLeche)",
            "formatString": "#,0",
            "lineageTag": "b1a3aade-3037-4208-b9aa-63649d7a44c0"
          },
          {
            "name": "Animales con produccion",
            "expression": "DISTINCTCOUNT(FactLeche[AnimalKey])",
            "formatString": "#,0",
            "lineageTag": "dc3afdfa-fa8b-4b9c-8dcb-b6ed9cd26b04"
          },
          {
            "name": "Litros por animal con produccion",
            "expression": "DIVIDE([Litros registrados], [Animales con produccion])",
            "formatString": "#,0.00",
            "lineageTag": "2159ae51-ce1c-4171-9506-e78e8c29fb9d"
          },
          {
            "name": "Dosis por fecha proxima",
            "expression": "CALCULATE([Vacunas aplicadas], USERELATIONSHIP(DimFecha[FechaKey], FactVacunacion[FechaProximaKey]), FactVacunacion[EsUltimoRegistro] = 1)",
            "formatString": "#,0",
            "lineageTag": "3888a8bd-39b9-43b9-b3bc-26a52c032ca3"
          },
          {
            "name": "Aviso demo",
            "expression": "\"DATOS FICTICIOS | Corte 07/10/2026\"",
            "lineageTag": "c26b374c-ac22-4af7-8406-5012979c3400"
          }
